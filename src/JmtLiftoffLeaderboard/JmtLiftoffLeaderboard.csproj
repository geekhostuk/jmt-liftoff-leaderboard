<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <AssemblyName>JmtLiftoffLeaderboard</AssemblyName>
    <RootNamespace>JmtLiftoffLeaderboard</RootNamespace>
    <AssemblyTitle>JMT Liftoff Leaderboard</AssemblyTitle>
    <Description>BepInEx plugin that puts the JMT FPV leaderboards and pilot profiles inside Liftoff's menus.</Description>
  </PropertyGroup>

  <!-- Generate BuildInfo from the version in Directory.Build.props, so the version
       lives in exactly one place. Plugin.PluginVersion / Plugin.BuildMarker read these. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <!-- IntermediateOutputPath is only set once the SDK targets have been imported,
         so this has to be resolved inside the target, not in a top-level PropertyGroup. -->
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <BuildInfoSource>
<![CDATA[// <auto-generated /> Written by the GenerateBuildInfo target — do not edit, do not commit.
namespace JmtLiftoffLeaderboard%3B

internal static class BuildInfo
{
    public const string Version = "$(Version)"%3B
    public const string Marker = "$(Version)+$(BuildRevision)"%3B
}
]]>
      </BuildInfoSource>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="$(BuildInfoSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Locate the Liftoff install. Set the LIFTOFF_DIR environment variable to override;
       otherwise the usual Steam library locations are probed, Linux first (the native
       depot ships the same managed assemblies as the Windows one), then the Windows default. -->
  <PropertyGroup>
    <LIFTOFF_DIR Condition="'$(LIFTOFF_DIR)' == '' And Exists('$(HOME)/.local/share/Steam/steamapps/common/Liftoff/Liftoff_Data/Managed')">$(HOME)/.local/share/Steam/steamapps/common/Liftoff</LIFTOFF_DIR>
    <LIFTOFF_DIR Condition="'$(LIFTOFF_DIR)' == '' And Exists('$(HOME)/.steam/steam/steamapps/common/Liftoff/Liftoff_Data/Managed')">$(HOME)/.steam/steam/steamapps/common/Liftoff</LIFTOFF_DIR>
    <LIFTOFF_DIR Condition="'$(LIFTOFF_DIR)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Liftoff</LIFTOFF_DIR>
    <Managed>$(LIFTOFF_DIR)\Liftoff_Data\Managed</Managed>
  </PropertyGroup>

  <!-- Set BEPINEX_CORE_DIR environment variable to override auto-detection.
       Probes both BepInEx (active) and _BepInEx (renamed/disabled) install folders. -->
  <PropertyGroup>
    <BEPINEX_CORE_DIR Condition="'$(BEPINEX_CORE_DIR)' == '' And Exists('$(LIFTOFF_DIR)\BepInEx\core\BepInEx.dll')">$(LIFTOFF_DIR)\BepInEx\core</BEPINEX_CORE_DIR>
    <BEPINEX_CORE_DIR Condition="'$(BEPINEX_CORE_DIR)' == '' And Exists('$(LIFTOFF_DIR)\_BepInEx\core\BepInEx.dll')">$(LIFTOFF_DIR)\_BepInEx\core</BEPINEX_CORE_DIR>
  </PropertyGroup>

  <Target Name="CheckBepInEx" BeforeTargets="Build">
    <Warning Condition="!Exists('$(BEPINEX_CORE_DIR)\BepInEx.dll')" Text="BepInEx not found at '$(BEPINEX_CORE_DIR)'. Set LIFTOFF_DIR environment variable to your Liftoff install folder." />
  </Target>

  <!-- Every reference is Private=false: the game and BepInEx supply these at runtime,
       and none of them may ever be copied into the build output or the repo. -->
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BEPINEX_CORE_DIR)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BEPINEX_CORE_DIR)\0Harmony.dll" Private="false" />

    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.SharedInternalsModule" HintPath="$(Managed)\UnityEngine.SharedInternalsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(Managed)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestTextureModule" HintPath="$(Managed)\UnityEngine.UnityWebRequestTextureModule.dll" Private="false" />

    <Reference Include="Newtonsoft.Json" HintPath="$(Managed)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(Managed)\com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(Managed)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(Managed)\PhotonRealtime.dll" Private="false" />
    <Reference Include="Photon3Unity3D" HintPath="$(Managed)\Photon3Unity3D.dll" Private="false" />
  </ItemGroup>

</Project>
